#!/usr/bin/expect -f

set timeout -1
set force_conservative 1

if {[llength $argv] != 1} {
    puts "Usage:   ./auto_import_pipeline <pipeline_name|all>"
    exit 1
}

set arg [lindex $argv 0]
set tmpfile "/tmp/auto_pipeline_[pid]"

cd /dbagiga/gs-odsx
log_file -noappend $tmpfile
spawn ./odsx.py dataengine oracle-cdc pipeline pipeline-operations import-pipeline

expect "or all): "
log_file

if {$arg eq "all"} {
    sleep 1
    send -- "a"
    sleep 0.3
    send -- "l"
    sleep 0.3
    send -- "l"
    sleep 1
    send -- "\n"
    expect eof
    exit 0
}

if {[string match "*.yaml" $arg]} {
    set filename $arg
} else {
    set filename "${arg}.yaml"
}

set fh [open $tmpfile r]
set content [read $fh]
close $fh
file delete $tmpfile

regsub -all {\x1b\[[0-9;]*[a-zA-Z]} $content "" clean
regsub -all {\r} $clean "" clean

# Escape dots in filename so they match literally in the regex
regsub -all {[.]} $filename {[.]} escaped_filename

set row_num ""

# Try exact filename match (e.g. my_pipeline.yaml)
foreach line [split $clean "\n"] {
    if {[regexp "\\|\\s+(\\d+)\\s+\\|\\s*${escaped_filename}\\s*\\|" $line -> num]} {
        set row_num $num
        break
    }
}

# Fallback: try matching the arg directly (without .yaml)
if {$row_num eq ""} {
    set escaped_arg $arg
    regsub -all {[.]} $escaped_arg {[.]} escaped_arg
    foreach line [split $clean "\n"] {
        if {[regexp "\\|\\s+(\\d+)\\s+\\|\\s*${escaped_arg}\\s*\\|" $line -> num]} {
            set row_num $num
            break
        }
    }
}

if {$row_num eq ""} {
    puts "\nFile '$filename' not found in pipeline folder."
    exit 1
}

sleep 1
foreach char [split $row_num ""] {
    send -- "$char"
    sleep 0.3
}
sleep 0.5
send -- "\n"

expect eof
